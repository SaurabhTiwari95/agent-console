# Copy to .env (git-ignored) with:  python scripts/make_env.py
# These values run the console on your laptop with dev login and the offline demo client:
# no Google, no Claude, no cost. See README, "Configuration", for every setting.

ENVIRONMENT=development
BASE_URL=http://127.0.0.1:8000
# Signs the session cookie. make_env.py fills in a random one; never reuse it between environments.
SESSION_SECRET=replace-with-a-long-random-secret
# Plain http is allowed only on localhost; keep true everywhere else.
SESSION_COOKIE_SECURE=false

# Who may sign in (comma-separated). Use your own address when you set up Google sign-in.
ALLOWED_EMAILS=dev@example.com

# Local development only. Refused at startup unless BASE_URL is localhost and ENVIRONMENT isn't production.
DEV_LOGIN_ENABLED=true
DEV_LOGIN_EMAIL=dev@example.com

# demo = offline stand-in (no key, no cost). anthropic = real Claude, needs ANTHROPIC_API_KEY in your shell.
CLAUDE_CLIENT=demo

# Google sign-in (see docs/deploy.md). Leave empty to use dev login only.
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=

# Storage: the console's own DB, next to the agent's index and spend ledger.
CONSOLE_DB_PATH=data/console.db
AGENT_DB_PATH=data/agent.db
INDEX_ON_START=sample_corpus

# The agent's caps (cost-capped-agent settings)
AGENT_RUN_CAP_USD=0.25
AGENT_DAY_CAP_USD=2.00
